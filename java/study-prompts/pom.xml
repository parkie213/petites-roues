<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>app.petitesroues</groupId>
    <artifactId>petites-roues-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>study-prompts</artifactId>

  <properties>
    <!-- Study prompt preparation runs on desktop and Android with Java 17. -->
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.testRelease>${java.version}</maven.compiler.testRelease>
  </properties>

  <dependencies>
    <dependency>
      <groupId>app.petitesroues</groupId>
      <artifactId>content-model</artifactId>
    </dependency>
    <dependency>
      <groupId>app.petitesroues</groupId>
      <artifactId>document-json</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- The quiz rules and types are owned once under agents/ and packaged for every caller. -->
      <resource>
        <targetPath>app/petitesroues/quiz</targetPath>
        <directory>../../agents/workflows</directory>
        <includes>
          <include>subtitle-quiz.md</include>
          <include>quiz-types.md</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
