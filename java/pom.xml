<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>app.petitesroues</groupId>
  <artifactId>petites-roues-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>document-model</module>
    <module>document-json</module>
    <module>content-library</module>
    <module>sync</module>
    <module>desktop-application</module>
    <module>desktop-server</module>
  </modules>

  <properties>
    <java.version>25</java.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>document-model</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>document-json</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>content-library</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>sync</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>desktop-application</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>desktop-server</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>document-model</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>

      <dependency>
        <groupId>app.petitesroues</groupId>
        <artifactId>desktop-application</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.4</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <java>
            <googleJavaFormat>
              <version>1.30.0</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
          <pom>
            <sortPom>
              <version>4.0.0</version>
              <nrOfIndentSpace>2</nrOfIndentSpace>
              <expandEmptyElements>false</expandEmptyElements>
              <keepBlankLines>true</keepBlankLines>
              <indentAttribute>all</indentAttribute>
              <indentSchemaLocation>true</indentSchemaLocation>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>format-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
