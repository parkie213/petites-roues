{
  "name": "petites-roues-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "vite build",
    "start": "node server.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:record": "RECORD=1 playwright test",
    "e2e:screenshots": "e2e/screenshots.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:site": "node build-site.mjs",
    "preview:site": "vite preview --outDir ../site/dist --port 18876 --strictPort"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "lucide-react": "1.60.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
