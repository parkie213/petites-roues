            "links": [
              {
                "source": [
                  0
                ],
                "translation": [
                  0
                ],
                "note": "那 (nà) = then, 好吧 (hǎo ba) = all right: \"all right then\"."
              },
              {
                "source": [
                  1
                ],
                "translation": [
                  1
                ],
                "note": "乔治 (Qiáozhì), George."
