      },
      {
        "line": {
          "id": "14b0657f-513f-5f2e-a767-e186e9e9baa5",
          "source": "乔治不喜欢吃黄瓜，不喜欢吃生菜，也不喜欢吃番茄。",
          "translation": "George doesn't like cucumber, doesn't like lettuce, and doesn't like tomatoes either.",
          "notes": [
            "The narrator is speaking."
          ],
          "alignment": {
            "source": [
              "乔治不喜欢吃黄瓜，",
              "不喜欢吃生菜，",
              "也不喜欢吃番茄。"
            ],
            "translation": [
              "George doesn't like cucumber,",
              "doesn't like lettuce,",
              "and doesn't like tomatoes either."
            ],
            "links": [
              {
                "source": [
                  0
                ],
                "translation": [
                  0
                ],
                "note": "不 (bù) before the verb = not. 黄瓜 (huánggua) = cucumber."
              },
              {
                "source": [
                  1
                ],
                "translation": [
                  1
                ],
                "note": "The subject 乔治 is not repeated, as in the English. 生菜 (shēngcài) = lettuce."
              },
              {
                "source": [
                  2
                ],
                "translation": [
                  2
                ],
                "note": "也 (yě) + 不 = not … either, closing the list. 番茄 (fānqié) = tomato."
              }
            ]
          },
          "continuesPrevious": false
