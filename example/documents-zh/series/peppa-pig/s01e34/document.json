              "噢，",
              "好吧。"
            ],
            "translation": [
              "Oh,",
              "all right."
            ],
            "links": [
              {
                "source": [
                  0
                ],
                "translation": [
                  0
                ],
                "note": "噢 (ō) = oh."
              },
              {
                "source": [
                  1
                ],
                "translation": [
                  1
                ],
                "note": "好 (hǎo) = good, OK. 吧 (ba) at the end softens it into a reluctant \"all right then\"."
              }
            ]
          },
          "continuesPrevious": false
        },
        "start": 13.9,
        "end": 15.5
      },
      {
