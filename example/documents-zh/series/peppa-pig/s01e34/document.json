    "cues": [
      {
        "line": {
          "id": "2d76af78-e9b7-506c-81d2-a712646f8c27",
          "source": "佩奇，你喜欢吃番茄吗？",
          "translation": "Peppa, do you like tomatoes?",
          "notes": [],
          "alignment": {
            "source": [
              "佩奇，",
              "你喜欢吃番茄吗？"
            ],
            "translation": [
              "Peppa,",
              "do you like tomatoes?"
            ],
            "links": [
              {
                "source": [
                  0
                ],
                "translation": [
                  0
                ],
                "note": "佩奇 (Pèiqí) is Peppa's Chinese name, chosen for its sound rather than its meaning: 佩 = admire, 奇 = wonderful. Grandpa is speaking."
              },
              {
                "source": [
                  1
                ],
                "translation": [
                  1
                ],
                "note": "你 (nǐ) = you. 喜欢 (xǐhuan) = like. Chinese says 喜欢吃 (xǐhuan chī), \"like eating\", for liking a food: 吃 (chī) = eat. 番茄 (fānqié) = tomato, literally \"foreign aubergine\". 吗 (ma) at the end turns a statement into a yes/no question; the word order does not change."
              }
            ]
          },
          "continuesPrevious": false
        },
        "start": 0.8,
        "end": 3.6
      },
      {
        "line": {
          "id": "3aaf2977-cc37-5ba7-a3bc-33a91598dbbd",
          "source": "我很喜欢，爷爷。",
          "translation": "I really like them, Grandpa.",
          "notes": [],
          "alignment": {
            "source": [
              "我很喜欢，",
              "爷爷。"
            ],
            "translation": [
              "I really like them,",
              "Grandpa."
            ],
            "links": [
              {
                "source": [
                  0
                ],
                "translation": [
                  0
                ],
                "note": "我 (wǒ) = I. 很 (hěn) = very, really. Chinese leaves out \"them\" because the tomatoes were just mentioned. Answering a 吗 question by repeating the verb is how Chinese says yes."
              },
              {
                "source": [
                  1
                ],
                "translation": [
                  1
                ],
                "note": "爷爷 (yéye) = grandpa, specifically your father's father. The show calls him 猪爷爷 (Zhū Yéye), Grandpa Pig."
              }
            ]
          },
          "continuesPrevious": false
        },
        "start": 3.6,
        "end": 5.5
      },
      {
        "line": {
          "id": "7227cdfe-fd3b-55e1-a2e2-c4b3bf4a4c05",
          "source": "乔治，那你喜欢吃番茄吗？",
          "translation": "George, what about you, do you like tomatoes?",
          "notes": [],
          "alignment": {
            "source": [
              "乔治，",
              "那你喜欢吃番茄吗？"
            ],
            "translation": [
              "George,",
              "what about you, do you like tomatoes?"
            ],
            "links": [
              {
                "source": [
                  0
                ],
                "translation": [
                  0
                ],
                "note": "乔治 (Qiáozhì) is the usual Chinese spelling of the name George."
              },
              {
                "source": [
                  1
                ],
                "translation": [
                  1
                ],
                "note": "那 (nà) = then, in that case: it turns the same question to someone new, like \"and you?\". The rest repeats Peppa's question."
              }
            ]
          },
          "continuesPrevious": false
        },
        "start": 5.5,
        "end": 8.3
      },
      {
        "line": {
